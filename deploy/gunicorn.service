[Unit]
Description=Grip and Drip API (gunicorn)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/srv/grip-and-drip/app
EnvironmentFile=/srv/grip-and-drip/app/.env
Environment=DJANGO_ENV=prod
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0750
ExecStart=/srv/grip-and-drip/app/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/gunicorn/gunicorn.sock \
    --workers 2 \
    --timeout 30 \
    --max-requests 1000 \
    --max-requests-jitter 100
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

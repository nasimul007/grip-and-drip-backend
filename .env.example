# Django
SECRET_KEY=your-secret-key-here-change-in-production
# dev on your own machine. Leave unset (or prod) on the server: it defaults to prod.
DJANGO_ENV=dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Production only
# Frontend origin(s) allowed to call the API from the browser, comma separated
CORS_ALLOWED_ORIGINS=https://your-shop-domain.com
# Needed for the admin login when served over HTTPS
CSRF_TRUSTED_ORIGINS=https://api.your-shop-domain.com
# Reverse proxies (nginx, Cloudflare...) in front of Django; used to find the real client IP
NUM_PROXIES=1
# Shared cache folder for rate limits and login lockouts; writable by the app user
CACHE_DIR=/var/tmp/grip-and-drip-cache

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/grip_and_drip

# CKEditor
CKEDITOR_UPLOAD_PATH=uploads/
